{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hollow-court-preview",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "hollow-court.com", "custom_domain": true }],
  "dev": { "host": "127.0.0.1", "upstream_protocol": "http" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "PREVIEW": "true",
    "PREVIEW_HOST": "hollow-court-preview.computer-toolbox.workers.dev",
    "PUBLIC_ORIGIN": "https://hollow-court.com",
    "PARTIFUL_URL": "https://partiful.com/e/CVuHCtIIuMl4G7JuWo2u",
    "OPENS_AT": "2026-10-31T20:00:00-04:00",
    "CLOSES_AT": "2026-11-01T02:00:00-05:00",
    "EVENT_ID": "halloween-2026",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hollow-court-preview",
      "migrations_dir": "migrations",
      "database_id": "4ef35131-eeef-4153-b422-8381f4d580ac",
    },
  ],
  "triggers": {
    "crons": ["15 8 * * *"],
  },
  "kv_namespaces": [
    {
      "binding": "PHOTOS",
      "id": "9a878e266b2848038c2a85d506506fb3",
    },
  ],
}
